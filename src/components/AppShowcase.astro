---

const screenshots = [
  { src: "/images/screenshots/screen1.png", alt: "Zeal 首页" },
  { src: "/images/screenshots/screen2.png", alt: "问题拆解" },
  { src: "/images/screenshots/screen3.png", alt: "对话交互" },
  { src: "/images/screenshots/screen4.png", alt: "模板引擎" },
  { src: "/images/screenshots/screen5.png", alt: "个性化记忆" },
  { src: "/images/screenshots/screen6.png", alt: "模型推荐" },
  { src: "/images/screenshots/screen7.png", alt: "结果展示" },
];
---

<section id="app-showcase" class="relative" style="height: 300vh">
  <div
    id="showcase-track"
    class="sticky top-0 h-screen flex flex-col items-center justify-center overflow-hidden bg-white"
  >
    <div class="text-center mb-8 md:mb-12">
      <span class="inline-block text-xs font-semibold text-brand-6 tracking-widest uppercase mb-3" style="font-family: var(--font-body)">Explore</span>
      <h2
        class="text-3xl md:text-[40px] font-semibold text-text-primary tracking-tight"
        style="font-family: var(--font-display)"
      >
        探索 Zeal
      </h2>
    </div>

    <div class="w-full overflow-hidden px-6">
      <div id="showcase-strip" class="flex gap-5 md:gap-8 will-change-transform">
        {screenshots.map((shot, i) => (
          <div class="flex-shrink-0 w-[240px] md:w-[280px]">
            <div
              class="rounded-2xl overflow-hidden bg-gradient-to-b from-gray-100 to-gray-50"
              style={`box-shadow: var(--shadow-card-elevation)`}
            >
              <img
                src={shot.src}
                alt={shot.alt}
                class="w-full h-auto"
                loading="lazy"
              />
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="flex items-center gap-2 mt-8 md:mt-12">
      {screenshots.map((_, i) => (
        <div
          id={`dot-${i}`}
          class={`h-[5px] rounded-full transition-all duration-300 ${i === 0 ? 'w-6 bg-brand-6' : 'w-[5px] bg-gray-300'}`}
        />
      ))}
    </div>
  </div>
</section>

<script>
  const section = document.getElementById("app-showcase");
  const strip = document.getElementById("showcase-strip");
  const dots = Array.from(document.querySelectorAll("[id^='dot-']"));

  function updateShowcase() {
    if (!section || !strip) return;

    const rect = section.getBoundingClientRect();
    const sectionHeight = section.offsetHeight;
    const viewportHeight = window.innerHeight;
    const scrollableDistance = sectionHeight - viewportHeight;

    const scrolled = -rect.top;
    const progress = Math.max(0, Math.min(1, scrolled / scrollableDistance));

    const stripWidth = strip.scrollWidth;
    const containerWidth = strip.parentElement!.offsetWidth;
    const maxTranslate = stripWidth - containerWidth;

    strip.style.transform = `translateX(${-progress * maxTranslate}px)`;

    const activeIndex = Math.min(
      dots.length - 1,
      Math.floor(progress * dots.length)
    );
    dots.forEach((dot, i) => {
      if (i === activeIndex) {
        dot.className = "h-[5px] w-6 rounded-full bg-brand-6 transition-all duration-300";
      } else {
        dot.className = "h-[5px] w-[5px] rounded-full bg-gray-300 transition-all duration-300";
      }
    });
  }

  window.addEventListener("scroll", updateShowcase, { passive: true });
  window.addEventListener("resize", updateShowcase);
  updateShowcase();
</script>
