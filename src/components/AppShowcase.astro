---
const items = [
  {
    src: "/images/screenshots/screen8.png",
    video: "/videos/demo.mp4",
    title: "拍照搜题",
    subtitle: "打开就是首页：拍照、相册、文件随手导入；快速、专注两种模式，一键切换",
    accent: "#1456f0",
  },
  {
    src: "/images/screenshots/screen2.png",
    title: "OCR 识别与编辑",
    subtitle: "识别结果可实时编辑，公式排版原样保留，改完即刻重新理解",
    accent: "#ea5ec1",
  },
  {
    src: "/images/screenshots/screen4.png",
    title: "问题理解",
    subtitle: "先弄清题目在问什么，前提与作答限制逐条列清，再开始求解",
    accent: "#8b5cf6",
  },
  {
    src: "/images/screenshots/screen5.png",
    title: "逐步学习",
    subtitle: "一次只学一步，理解之后再继续，节奏跟着你走",
    accent: "#3daeff",
  },
  {
    src: "/images/screenshots/screen6.png",
    title: "引导练习",
    subtitle: "快速模式下边答边学，随时快捷质疑，卡点当场讲清",
    accent: "#f97316",
  },
  {
    src: "/images/screenshots/screen7.png",
    title: "AI 追问",
    subtitle: "开始前先问你在卡哪，讲解更对症，答完还能继续问",
    accent: "#10b981",
  },
];
---

<section id="app-showcase" class="bg-surface-white">
  <!-- Title -->
  <div class="py-24 md:py-36 px-6">
    <div class="max-w-4xl mx-auto text-center showcase-reveal">
      <span class="inline-block text-xs font-semibold text-brand-6 tracking-widest uppercase mb-4" style="font-family: var(--font-body)">Explore</span>
      <h2
        class="text-4xl md:text-[56px] font-medium text-text-primary tracking-tight mb-5"
        style="font-family: var(--font-display)"
      >
        探索 Zeal
      </h2>
      <p class="text-base md:text-lg text-text-secondary max-w-md mx-auto leading-[1.7]" style="font-family: var(--font-body)">
        从拍照到学会，每一步都讲明白
      </p>
    </div>
  </div>

  <!-- Showcase items -->
  {items.map((item, i) => {
    const isEven = i % 2 === 0;
    return (
      <div class="showcase-item min-h-screen flex items-center px-6 md:px-0" data-index={i}>
        <div class={`w-full max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-10 md:gap-20 ${isEven ? '' : 'md:flex-row-reverse'}`}>

          {/* Phone mockup with decorative elements */}
          <div class="showcase-phone w-full md:w-1/2 flex-shrink-0 flex justify-center">
            <div class="relative py-6 md:py-10">
              {/* Background gradient orb */}
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] md:w-[400px] h-[320px] md:h-[400px] rounded-full blur-[80px] opacity-[0.06]" style={`background: ${item.accent}`}></div>

              {/* Decorative elements */}
              <div class="absolute top-4 right-2 w-10 h-10 rounded-full border opacity-[0.08] hidden md:block" style={`border-color: ${item.accent}`}></div>
              <div class="absolute bottom-8 left-0 w-3 h-3 rounded-full opacity-[0.18]" style={`background: ${item.accent}`}></div>
              <div class="absolute top-1/3 -left-2 w-2 h-2 rounded-full opacity-[0.25]" style={`background: ${item.accent}`}></div>
              <div class="absolute bottom-1/3 -right-1 w-1.5 h-1.5 rounded-full opacity-[0.3]" style={`background: ${item.accent}`}></div>
              <div class="absolute top-2/3 right-4 w-6 h-6 rounded-full opacity-[0.04] hidden md:block" style={`background: ${item.accent}`}></div>
              <div class="absolute -top-6 -left-6 w-20 h-20 rounded-full border-2 opacity-[0.04] hidden md:block" style={`border-color: ${item.accent}`}></div>

              {/* Phone frame */}
              <div class="relative w-[260px] md:w-[300px] rounded-[2.5rem] p-2 bg-white/95 backdrop-blur-sm" style={`box-shadow: 0 25px 60px -12px ${item.accent}20, 0 12px 28px -8px rgba(0,0,0,0.08), 0 0 0 1px rgba(0,0,0,0.03)`}>
                <div class="relative rounded-[2rem] overflow-hidden bg-surface-light">
                  {item.video ? (
                    <div class="relative showcase-video-wrap">
                      <video
                        src={item.video}
                        poster="/images/screenshots/video-poster-home.jpg"
                        muted
                        playsinline
                        preload="metadata"
                        class="w-full h-auto block"
                      ></video>
                      <button class="video-replay-btn absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-14 h-14 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95" style="box-shadow: 0 8px 24px rgba(0,0,0,0.15)" aria-label="播放演示">
                        <svg class="btn-icon-play" width="20" height="20" viewBox="0 0 24 24" fill="#1456f0" style="margin-left: 2px"><path d="M8 5.5v13l11-6.5-11-6.5z"/></svg>
                        <svg class="btn-icon-replay hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1456f0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
                      </button>
                    </div>
                  ) : (
                    <img
                      src={item.src}
                      alt={item.title}
                      class="w-full h-auto block"
                      loading="lazy"
                    />
                  )}
                  <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-white/5 to-transparent pointer-events-none"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Text -->
          <div class="showcase-text w-full md:w-1/2 flex-shrink-0">
            <div class={`max-w-sm ${isEven ? 'md:text-left' : 'md:text-right md:ml-auto'}`}>
              <span class="inline-block text-xs font-semibold tracking-widest uppercase mb-4 opacity-40" style={`color: ${item.accent}; font-family: var(--font-body)`}>
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3
                class="text-2xl md:text-[36px] font-semibold text-text-primary mb-4 tracking-tight leading-[1.2]"
                style="font-family: var(--font-display)"
              >
                {item.title}
              </h3>
              <p
                class="text-sm md:text-base text-text-secondary leading-[1.8]"
                style="font-family: var(--font-body)"
              >
                {item.subtitle}
              </p>
              <div class="mt-6 w-12 h-[2px] rounded-full opacity-60" style={`background: ${item.accent}; ${isEven ? '' : 'margin-left: auto'}`}></div>
            </div>
          </div>

        </div>
      </div>
    );
  })}

  <!-- Bottom spacer -->
  <div class="h-20"></div>
</section>

<style>
  .showcase-item {
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .showcase-item[data-index="0"] { transform: translateY(40px); }
  .showcase-item[data-index="1"] { transform: translateY(40px); }
  .showcase-item[data-index="2"] { transform: translateY(40px); }
  .showcase-item[data-index="3"] { transform: translateY(40px); }
  .showcase-item[data-index="4"] { transform: translateY(40px); }
  .showcase-item[data-index="5"] { transform: translateY(40px); }

  .showcase-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .showcase-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .showcase-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .showcase-phone {
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
  }

  .showcase-item:nth-child(odd) .showcase-phone {
    transform: translateX(-30px);
  }

  .showcase-item:nth-child(even) .showcase-phone {
    transform: translateX(30px);
  }

  .showcase-item.visible .showcase-phone {
    transform: translateX(0);
  }

  .showcase-text {
    opacity: 0;
    transition: opacity 0.6s ease 0.3s;
  }

  .showcase-item.visible .showcase-text {
    opacity: 1;
  }
</style>

<script>
  function initShowcase() {
    const items = document.querySelectorAll(".showcase-item, .showcase-reveal");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    items.forEach((el) => observer.observe(el));
  }

  initShowcase();
  document.addEventListener("astro:after-swap", initShowcase);

  function initVideoReplay() {
    document.querySelectorAll(".showcase-video-wrap").forEach((wrap) => {
      const btn = wrap.querySelector(".video-replay-btn");
      const video = wrap.querySelector("video");
      if (!btn || !video) return;
      const iconPlay = btn.querySelector(".btn-icon-play");
      const iconReplay = btn.querySelector(".btn-icon-replay");
      const showButton = (replay: boolean) => {
        btn.style.opacity = "1";
        btn.style.pointerEvents = "auto";
        iconPlay.classList.toggle("hidden", replay);
        iconReplay.classList.toggle("hidden", !replay);
      };
      const hideButton = () => {
        btn.style.opacity = "0";
        btn.style.pointerEvents = "none";
      };
      btn.addEventListener("click", () => {
        video.currentTime = 0;
        video.play();
        hideButton();
      });
      video.addEventListener("ended", () => showButton(true));
    });
  }
  initVideoReplay();
  document.addEventListener("astro:after-swap", initVideoReplay);
</script>
