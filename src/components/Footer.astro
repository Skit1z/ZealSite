---
const footerLinks = [
  { label: "产品", href: "#products" },
  { label: "特色", href: "#features" },
  { label: "关于", href: "#hero" },
];
---

<footer id="footer" class="bg-text-charcoal py-12 md:py-16 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-10">
      <div>
        <span class="text-2xl font-bold text-white font-display">Zeal</span>
        <p class="mt-3 text-sm text-white/60 leading-[1.70]" style="font-family: var(--font-body)">
          面向新一代 AI 大模型的提示词工程平台，让复杂问题变得简单。
        </p>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-white/80 mb-4" style="font-family: var(--font-body)">
          快速链接
        </h4>
        <ul class="space-y-2">
          {footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/60 hover:text-white/90 transition-colors"
                style="font-family: var(--font-body)"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-white/80 mb-4" style="font-family: var(--font-body)">
          联系我们
        </h4>
        <p class="text-sm text-white/60 leading-[1.70]" style="font-family: var(--font-body)">
          有任何问题或合作意向，欢迎随时联系我们。
        </p>
      </div>
    </div>

    <div class="border-t border-white/10 pt-6 text-center">
      <p class="text-xs text-white/40" style="font-family: var(--font-body)">
        © {new Date().getFullYear()} Zeal. All rights reserved.
      </p>
    </div>
  </div>
</footer>
