---
const footerLinks = [
  { label: "产品", href: "#products" },
  { label: "特色", href: "#features" },
  { label: "关于", href: "#hero" },
];
---

<footer id="footer" class="bg-text-charcoal pt-16 pb-10 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <div>
        <div class="flex items-center gap-2.5 mb-4">
          <img src="/images/zeal-icon.png" alt="Zeal" class="w-7 h-7 rounded-lg" />
          <span class="text-lg font-semibold text-white tracking-tight" style="font-family: var(--font-display)">Zeal</span>
        </div>
        <p class="text-sm text-white/50 leading-[1.7] max-w-xs" style="font-family: var(--font-body)">
          面向新一代 AI 大模型的提示词工程平台，让复杂问题变得简单。
        </p>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-white/40 uppercase tracking-widest mb-5" style="font-family: var(--font-body)">
          快速链接
        </h4>
        <ul class="space-y-3">
          {footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/60 hover:text-white transition-colors"
                style="font-family: var(--font-body)"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-white/40 uppercase tracking-widest mb-5" style="font-family: var(--font-body)">
          联系我们
        </h4>
        <p class="text-sm text-white/50 leading-[1.7]" style="font-family: var(--font-body)">
          有任何问题或合作意向，<br />欢迎随时联系我们。
        </p>
      </div>
    </div>

    <div class="border-t border-white/[0.06] pt-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-white/30" style="font-family: var(--font-body)">
        &copy; {new Date().getFullYear()} Zeal. All rights reserved.
      </p>

      <a
        href="https://beian.mps.gov.cn/#/query/webSearch?code=37112202000311"
        rel="noreferrer"
        target="_blank"
        class="inline-flex items-center gap-1.5 text-xs text-white/40 transition-colors hover:text-white/70"
        style="font-family: var(--font-body)"
      >
        <img
          src="/images/备案图标.png"
          alt=""
          width="18"
          height="20"
          class="h-5 w-[18px] object-contain"
        />
        <span>鲁公网安备37112202000311号</span>
      </a>
    </div>
  </div>
</footer>
