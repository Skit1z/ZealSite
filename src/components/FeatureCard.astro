---
interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;
---

<div
  class="bg-surface-white rounded-xl p-6 md:p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-card-elevation"
  style="box-shadow: var(--shadow-standard)"
>
  <div class="text-3xl mb-4">{icon}</div>
  <h3
    class="text-lg font-medium text-text-primary mb-2"
    style="font-family: var(--font-mid)"
  >
    {title}
  </h3>
  <p
    class="text-sm text-text-secondary leading-[1.70]"
    style="font-family: var(--font-body)"
  >
    {description}
  </p>
</div>
