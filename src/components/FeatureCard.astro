---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  description: string;
  iconName: string;
}

const { title, description, iconName } = Astro.props;
---

<div
  class="group bg-white rounded-2xl p-6 md:p-7 border border-border-light transition-all duration-300 hover:-translate-y-1 hover:shadow-card-elevation hover:border-transparent"
>
  <div class="w-10 h-10 rounded-xl bg-brand-6/[0.06] flex items-center justify-center mb-5 group-hover:bg-brand-6/[0.1] transition-colors">
    <Icon name={iconName} size={20} class="text-brand-6" />
  </div>
  <h3
    class="text-base font-semibold text-text-primary mb-2 tracking-tight"
    style="font-family: var(--font-mid)"
  >
    {title}
  </h3>
  <p
    class="text-sm text-text-secondary leading-[1.7]"
    style="font-family: var(--font-body)"
  >
    {description}
  </p>
</div>
