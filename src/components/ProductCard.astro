---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  description: string;
  gradient: string;
  iconName: string;
}

const { title, description, gradient, iconName } = Astro.props;
---

<div
  class="group relative rounded-2xl p-6 md:p-8 text-white transition-all duration-300 hover:-translate-y-1 hover:shadow-card-elevation overflow-hidden"
  style={`background: ${gradient}; box-shadow: var(--shadow-brand-glow)`}
>
  <div class="absolute top-0 right-0 w-32 h-32 bg-white/[0.08] rounded-full -translate-y-1/2 translate-x-1/2"></div>
  <div class="relative">
    <div class="w-10 h-10 rounded-xl bg-white/15 backdrop-blur-sm flex items-center justify-center mb-5">
      <Icon name={iconName} size={20} class="text-white" />
    </div>
    <h3
      class="text-xl md:text-2xl font-semibold leading-[1.4] mb-2 tracking-tight"
      style="font-family: var(--font-display)"
    >
      {title}
    </h3>
    <p
      class="text-sm text-white/75 leading-[1.6]"
      style="font-family: var(--font-body)"
    >
      {description}
    </p>
  </div>
</div>
