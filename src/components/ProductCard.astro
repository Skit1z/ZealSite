---
interface Props {
  title: string;
  description: string;
  gradient: string;
  icon: string;
}

const { title, description, gradient, icon } = Astro.props;
---

<div
  class="group relative rounded-3xl p-6 md:p-8 text-white transition-all duration-300 hover:-translate-y-1 hover:shadow-card-elevation"
  style={`background: ${gradient}; box-shadow: var(--shadow-brand-glow)`}
>
  <div class="text-3xl mb-4">{icon}</div>
  <h3
    class="text-xl md:text-[28px] font-medium leading-[1.71] mb-2"
    style="font-family: var(--font-display)"
  >
    {title}
  </h3>
  <p
    class="text-sm md:text-base text-white/80 leading-[1.50]"
    style="font-family: var(--font-body)"
  >
    {description}
  </p>
</div>
