---
const features = [
  {
    title: "精准定位",
    description: "新用户注册即进行个性化分析，将用户身份与平台绑定，生成内容更贴合用户需求",
    accent: "#1456f0",
  },
  {
    title: "跨平台兼容",
    description: "生成的提示词可直接复制到其他 AI 平台使用，也可在本平台选择最优模型直接提问",
    accent: "#ea5ec1",
  },
  {
    title: "自主微调",
    description: "基于开源模型的自主微调优化，结合用户个性化记忆，显著提升解决问题的准确率",
    accent: "#8b5cf6",
  },
  {
    title: "持续进化",
    description: "未来将结合头脑风暴、人格测试等，开放社区模块，注重 UGC 和 PGC 开发",
    accent: "#10b981",
  },
];
---

<section id="features" class="py-24 md:py-36 px-6" style="background: linear-gradient(180deg, #fafbfd 0%, #ffffff 100%)">
  <div class="max-w-6xl mx-auto">
    <!-- Header with Zeal icon -->
    <div class="text-center mb-16 md:mb-24 scroll-animate">
      <div class="w-14 h-14 mx-auto mb-8 rounded-2xl overflow-hidden" style="box-shadow: 0 8px 24px rgba(20, 86, 240, 0.1)">
        <img src="/images/zeal-icon.png" alt="Zeal" class="w-full h-full" />
      </div>
      <span class="inline-block text-xs font-semibold text-brand-6 tracking-widest uppercase mb-4" style="font-family: var(--font-body)">Why Zeal</span>
      <h2
        class="text-3xl md:text-[48px] font-semibold text-text-primary tracking-tight"
        style="font-family: var(--font-display)"
      >
        为什么选择 Zeal
      </h2>
    </div>

    <!-- Feature list -->
    <div class="max-w-3xl mx-auto">
      {features.map((feature, i) => (
        <div class="scroll-animate" style={`animation-delay: ${i * 0.08}s`}>
          <div class="feature-row group flex items-start gap-6 md:gap-10 py-8 md:py-10 transition-all duration-300" style={`border-bottom: 1px solid ${i === features.length - 1 ? 'transparent' : 'var(--color-border-light)'}`}>
            <span class="text-3xl md:text-5xl font-semibold tracking-tighter leading-none shrink-0 transition-colors duration-300" style={`color: ${feature.accent}; opacity: 0.15; font-family: var(--font-display)`}>
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="pt-1">
              <h3 class="text-lg md:text-xl font-semibold text-text-primary tracking-tight mb-2" style="font-family: var(--font-display)">
                {feature.title}
              </h3>
              <p class="text-sm md:text-base text-text-secondary leading-[1.8]" style="font-family: var(--font-body)">
                {feature.description}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-row:hover span {
    opacity: 0.35 !important;
  }
</style>
