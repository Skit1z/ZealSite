---
import ProductCard from "./ProductCard.astro";

const products = [
  {
    title: "OCR 智能识别",
    description: "结合 OCR 与 Markdown 编辑，快速获取内容，让信息处理更高效",
    gradient: "linear-gradient(135deg, #1456f0, #3daeff)",
    iconName: "ocr",
  },
  {
    title: "多轮问题拆解",
    description: "交互式对话逐步明确需求，将复杂问题智能拆分为可执行的子任务",
    gradient: "linear-gradient(135deg, #ea5ec1, #f472b6)",
    iconName: "layers",
  },
  {
    title: "模板引擎",
    description: "智能匹配最优模板，生成结构清晰、AI 易读的高效提示词",
    gradient: "linear-gradient(135deg, #8b5cf6, #a78bfa)",
    iconName: "template",
  },
  {
    title: "个性化记忆",
    description: "基于用户画像的定制化优化，越用越懂你，准确率持续提升",
    gradient: "linear-gradient(135deg, #f97316, #fb923c)",
    iconName: "memory",
  },
  {
    title: "模型推荐",
    description: "系统智能推荐最适合的 AI 模型，一键直达最佳答案",
    gradient: "linear-gradient(135deg, #10b981, #34d399)",
    iconName: "target",
  },
];
---

<section id="products" class="py-20 md:py-28 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14 md:mb-20 scroll-animate">
      <span class="inline-block text-xs font-semibold text-brand-6 tracking-widest uppercase mb-3" style="font-family: var(--font-body)">Core Capabilities</span>
      <h2
        class="text-3xl md:text-[40px] font-semibold text-text-primary tracking-tight"
        style="font-family: var(--font-display)"
      >
        核心能力
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
      {products.map((product, i) => (
        <div class={`scroll-animate ${i >= 3 ? 'sm:col-span-1 lg:col-span-1' : ''}`} style={`animation-delay: ${i * 0.08}s`}>
          <ProductCard {...product} />
        </div>
      ))}
    </div>
  </div>
</section>
